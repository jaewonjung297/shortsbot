#!/usr/bin/env python3
"""Paste a Reddit post (or a town rule), start the `story` GitHub Actions workflow, and watch it run.

  scripts/story                      # paste the post, end with Ctrl-D
  pbpaste | scripts/story            # from the clipboard
  scripts/story post.txt             # from a file
  scripts/story --example story_cat  # skip Claude, render examples/story_cat.json
  scripts/story --mode in_this_town                                   # pitch 10 rules, pick one, approve the bible
  scripts/story --mode in_this_town --rule "In this town, ..." --runtime 60 --town-name Dimwick
  scripts/story --mode in_this_town --rule "In this town, ..." --yes  # all steps at once, no approval stop
  scripts/story --mode what_if --premise "What if the Moon came twice as close?"
  scripts/story --from-run 123456789 # skip Claude, re-render the spec from an earlier run
  scripts/story --no-inbox --notes "keep it light" --voice am_adam post.txt

Needs the GitHub CLI (`gh auth login` once). When the run finishes it downloads the video into out/story-<run id>/.
"""
import argparse, calendar, json, os, subprocess, sys, tempfile, time

WORKFLOW = "story.yml"
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def gh(*args, capture=True):
    r = subprocess.run(["gh", *args], cwd=ROOT, text=True, capture_output=capture)
    if r.returncode: sys.exit("gh %s failed:\n%s" % (" ".join(args[:3]), (r.stderr or "").strip()))
    return r.stdout

def ask(prompt):
    """Read an answer from the terminal even when stdin was a pipe."""
    try:
        with open("/dev/tty") as tty:
            print(prompt, end="", flush=True)
            return tty.readline().strip()
    except OSError:
        return ""

def run(a, ref, fields):
    """Start the workflow with these inputs, watch it, return the run id."""
    args = ["workflow", "run", WORKFLOW, "--ref", ref]
    for k, v in fields.items():
        if v not in (None, ""): args += ["-f", "%s=%s" % (k, v)]
    started = time.time()
    gh(*args)
    print("Started the story workflow on %s; finding the run..." % ref)
    found = None
    for _ in range(30):
        runs = json.loads(gh("run", "list", "--workflow", WORKFLOW, "--branch", ref, "--event", "workflow_dispatch",
                             "--limit", "5", "--json", "databaseId,createdAt,url,displayTitle"))
        fresh = [r for r in runs if calendar.timegm(time.strptime(r["createdAt"], "%Y-%m-%dT%H:%M:%SZ")) >= started - 30]
        if fresh: found = fresh[0]; break
        time.sleep(2)
    if not found: sys.exit("Couldn't find the run; check the Actions tab.")
    rid = str(found["databaseId"])
    print("Run: %s\n    %s\n" % (found["displayTitle"], found["url"]))
    if subprocess.run(["gh", "run", "watch", rid, "--interval", "5", "--exit-status"], cwd=ROOT).returncode:
        print("\nThe run failed. Failed steps' logs:\n")
        subprocess.run(["gh", "run", "view", rid, "--log-failed"], cwd=ROOT)
        sys.exit(1)
    return rid

def artifact(rid, name):
    """Download one artifact of a run into a temp dir; None if the run has no such artifact."""
    d = tempfile.mkdtemp(prefix="story-")
    r = subprocess.run(["gh", "run", "download", rid, "--name", name, "--dir", d], cwd=ROOT, capture_output=True, text=True)
    return d if r.returncode == 0 else None

def deliver(rid, mode):
    name = ("tiktok-" if mode == "what_if" else "story-") + rid
    out = os.path.join(ROOT, "out", name)
    gh("run", "download", rid, "--name", name, "--dir", out)
    print("\nDone. Files in %s" % out)
    for f in ("short.mp4", "caption.txt", "cover.jpg"):
        if os.path.exists(os.path.join(out, f)): print("  " + f)
    cap = os.path.join(out, "caption.txt")
    if os.path.exists(cap):
        text = open(cap).read().strip()
        print("\nCaption:\n  " + text)
        if sys.platform == "darwin":
            subprocess.run(["pbcopy"], input=text, text=True)
            print("  (copied to the clipboard)")
    if sys.platform == "darwin" and os.path.exists(os.path.join(out, "short.mp4")):
        subprocess.run(["open", "-R", os.path.join(out, "short.mp4")])

def town_loop(a, ref, base, rid):
    """in_this_town checkpoints: pick a pitched rule, approve or tweak the bible, then render."""
    while True:
        d = artifact(rid, "pitches")
        if d and not artifact(rid, "bible"):
            ps = json.load(open(os.path.join(d, "pitches.json")))
            print("\nPick a town rule:\n")
            for i, p in enumerate(ps, 1):
                print("%2d. %s\n    frame 1: %s\n    why: %s\n" % (i, p["rule"], p["frame1"], p["curiosity"]))
            ans = ask("Number, your own rule, or Enter to stop: ")
            if not ans: return
            rule = ps[int(ans) - 1]["rule"] if ans.isdigit() and 1 <= int(ans) <= len(ps) else ans
            rid = run(a, ref, dict(base, story=rule, label=rule[:60]))
            continue
        d = artifact(rid, "bible")
        if d and not artifact(rid, "story-" + rid):
            print("\n" + open(os.path.join(d, "bible.md")).read())
            ans = ask("Approve and render? [y = render / type tweaks to revise / Enter = stop]: ")
            if not ans: print("Stopped. Render it later with: scripts/story --mode in_this_town --from-run %s --yes" % rid); return
            if ans.lower() in ("y", "yes"):
                rid = run(a, ref, dict(base, from_run=rid, approved="true", label="render " + rid))
            else:
                rid = run(a, ref, dict(base, from_run=rid, approved="false", notes=ans, label="revise " + rid))
            continue
        return deliver(rid, a.mode)

def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("file", nargs="?", help="text file with the post, rule or premise (default: read stdin)")
    p.add_argument("--mode", default="reddit_story", choices=["reddit_story", "in_this_town", "what_if"])
    p.add_argument("--premise", help="premise for what_if (default: Claude invents one)")
    p.add_argument("--rule", help="in_this_town: the town rule (default: Claude pitches 10)")
    p.add_argument("--runtime", default="75", choices=["20", "45", "60", "75", "90", "150"], help="in_this_town: seconds")
    p.add_argument("--town-name", default="", help="in_this_town: town name (default: Claude invents one)")
    p.add_argument("--yes", action="store_true", help="in_this_town: skip the bible approval stop")
    p.add_argument("--example", help="render a spec from examples/ instead of condensing a post")
    p.add_argument("--from-run", help="reuse the spec (or in_this_town bible) from an earlier story run")
    p.add_argument("--notes", default="", help="notes for Claude (tone, emphasis)")
    p.add_argument("--voice", default="auto", choices=["auto", "af_heart", "af_bella", "am_michael", "am_adam"])
    p.add_argument("--parts", default="6", choices=["4", "6", "8"])
    p.add_argument("--no-inbox", action="store_true", help="don't send the result to the TikTok inbox")
    p.add_argument("--ref", default=None, help="branch to run the workflow from (default: current branch)")
    a = p.parse_args()

    story = ""
    if a.mode == "in_this_town":
        story = a.rule or a.premise or (open(a.file).read().strip() if a.file else "")
    elif a.mode == "what_if":
        story = a.premise or (open(a.file).read().strip() if a.file else "")
    elif not (a.example or a.from_run):
        if a.file: story = open(a.file).read()
        else:
            if sys.stdin.isatty(): print("Paste the post, then press Ctrl-D:\n", file=sys.stderr)
            story = sys.stdin.read()
        story = story.strip()
        if len(story) < 200: sys.exit("That post looks too short (%d chars)." % len(story))
    label = (a.example or (story[:60] if a.mode != "reddit_story" else None) or (("rerender " + a.from_run) if a.from_run else None)
             or (story.splitlines()[0][:60] if story else None) or ("pitch rules" if a.mode == "in_this_town" else "fresh idea"))
    ref = a.ref or subprocess.run(["git", "branch", "--show-current"], cwd=ROOT, text=True, capture_output=True).stdout.strip() or "main"

    base = {"mode": a.mode, "voice": a.voice, "parts": a.parts, "send_to_inbox": "false" if a.no_inbox else "true"}
    if a.mode == "in_this_town":
        base.update(runtime=a.runtime, town_name=a.town_name)
    first = dict(base, label=label, notes=a.notes)
    if a.example: first["example"] = a.example
    elif a.from_run: first["from_run"] = a.from_run
    elif story: first["story"] = story
    if a.mode == "in_this_town" and a.yes: first["approved"] = "true"
    rid = run(a, ref, first)
    if a.mode == "in_this_town": town_loop(a, ref, base, rid)
    else: deliver(rid, a.mode)

if __name__ == "__main__":
    main()
